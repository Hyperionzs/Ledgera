// ============================================================================
// Ledgera — Prisma Schema
// This is the single source of truth for the database structure.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Application role enum — single role per user (MVP).
// Migrate to a join table when multi-role becomes a real requirement.
// ---------------------------------------------------------------------------
enum Role {
  OWNER
  ADMIN
  CASHIER
}

// ---------------------------------------------------------------------------
// User — authentication + profile data.
// passwordHash is nullable to support future OAuth-only accounts.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions RefreshToken[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// RefreshToken — doubles as the active session record.
// sessionId in the JWT payload is this record's id.
// tokenHash stores sha256(refreshToken) — never the raw token.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  replacedBy String?  @map("replaced_by") // id of the rotated successor — reuse detection
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Product — catalog item. categoryId is nullable until Category module (Sprint 4).
// deletedAt enables soft delete — products are never physically removed.
// Prices use Decimal to avoid floating-point money errors.
// ---------------------------------------------------------------------------
model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  categoryId    String?  @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  supplierId    String?  @map("supplier_id")
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(12, 2)
  minimumStock  Int      @default(0) @map("minimum_stock")
  stock         Int      @default(0)
  isActive      Boolean  @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  movements StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Category — hierarchical product grouping (self-relation for parent/children).
// name must be unique per parent. Postgres treats NULL as distinct, so the
// composite @@unique([name, parentId]) does NOT enforce root uniqueness —
// root-level duplicate names are guarded in the service layer.
// deletedAt enables soft delete; a deleted name may be reused.
// ---------------------------------------------------------------------------
model Category {
  id          String     @id @default(uuid())
  name        String
  parentId    String?    @map("parent_id")
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([name, parentId])
  @@index([parentId])
  @@index([name])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// MovementType — direction of a stock change. ADJUSTMENT is a manual correction
// (e.g. broken, expired, cycle count) and always requires a reason.
// STOCK_IN / STOCK_OUT are typically tied to Purchase / Sale via reference.
// ---------------------------------------------------------------------------
enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Supplier — vendor that supplies products. No unique DB constraint on name or
// email: Postgres treats NULL as distinct, and soft-deleted suppliers may reuse
// both. Uniqueness (among active suppliers) is enforced in the service layer.
// ---------------------------------------------------------------------------
model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]
  purchases Purchase[]

  @@index([name])
  @@index([email])
  @@index([isActive])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// StockMovement — immutable audit trail of every stock change.
// quantity is always positive; direction is implied by type, and before/after
// snapshots make the delta explicit without re-deriving from history.
// ADJUSTMENT stores |after - before| in quantity; reason is mandatory for it.
// ---------------------------------------------------------------------------
model StockMovement {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  product       Product      @relation(fields: [productId], references: [id])
  type          MovementType
  quantity      Int
  beforeStock   Int          @map("before_stock")
  afterStock    Int          @map("after_stock")
  reason        String?
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// PurchaseStatus — life cycle of a purchase order. MVP creates directly as
// RECEIVED (goods already arrived ⇒ stock-in immediately). DRAFT / CANCELLED
// pipelines are future work.
// ---------------------------------------------------------------------------
enum PurchaseStatus {
  RECEIVED
}

// ---------------------------------------------------------------------------
// Purchase — a received shipment from a supplier. Created atomically with its
// items and the resulting stock-in movements (one transaction). supplierName
// is a snapshot so history stays accurate when the supplier master changes.
// ---------------------------------------------------------------------------
model Purchase {
  id           String         @id @default(uuid())
  referenceNo  String         @map("reference_no")
  supplierId   String?        @map("supplier_id")
  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String         @map("supplier_name")
  status       PurchaseStatus @default(RECEIVED)
  notes        String?
  totalAmount  Decimal        @map("total_amount") @db.Decimal(14, 2)
  createdAt    DateTime       @default(now()) @map("created_at")

  items PurchaseItem[]

  @@index([supplierId])
  @@map("purchases")
}

// ---------------------------------------------------------------------------
// PurchaseItem — one line of a purchase. productName is a snapshot. unitPrice
// and totalAmount are denormalized at creation, never recomputed.
// ---------------------------------------------------------------------------
model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String   @map("purchase_id")
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------------
// Customer — buyer that makes purchases. Every sale must link to a customer,
// either a registered customer or the special Walk-in sentinel. customerName
// is a snapshot captured at sale time for immutable history.
// deletedAt enables soft delete; deleted customers remain in sale history.
// Email uniqueness is managed via a partial unique index in the database
// (PostgreSQL: CREATE UNIQUE INDEX idx_customer_email_active ON customers(email)
// WHERE is_active = true AND deleted_at IS NULL)
// This allows deleted customers' emails to be reused.
// ---------------------------------------------------------------------------
model Customer {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(100)  // required, indexed for search
  email     String?   @db.VarChar(100)  // optional, unique only for active customers (see partial index)
  phone     String?   @db.VarChar(20)  // optional, no unique constraint
  address   String?   @db.VarChar(200)  // single address, optional
  city      String?   @db.VarChar(100)  // optional
  notes     String?   @db.VarChar(500)  // internal notes

  // Lifecycle
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")  // soft-delete
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  sales Sale[]

  // Indexes for fast lookup
  @@index([name])
  @@index([phone])
  @@index([isActive])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// SaleStatus — life cycle of a sale. MVP creates directly as COMPLETED
// (cash sale recorded immediately). DRAFT / CANCELLED pipelines are future work.
// ---------------------------------------------------------------------------
enum SaleStatus {
  COMPLETED
}

// ---------------------------------------------------------------------------
// Sale — a completed sale transaction. customerId is required and links to
// Customer (use sentinel Walk-in UUID for anonymous sales).
// customerName is recorded at sale time as a snapshot. totalAmount is denormalized
// for quick reporting and never recomputed.
// ---------------------------------------------------------------------------
model Sale {
  id           String      @id @default(uuid())
  referenceNo  String      @map("reference_no")
  customerId   String      @map("customer_id")  // ← now required (links to Customer)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String      @map("customer_name")  // ← snapshot at sale time
  status       SaleStatus  @default(COMPLETED)
  notes        String?
  totalAmount  Decimal     @map("total_amount") @db.Decimal(14, 2)
  createdAt    DateTime    @default(now()) @map("created_at")

  items SaleItem[]

  @@index([customerId])
  @@index([createdAt])
  @@map("sales")
}

// ---------------------------------------------------------------------------
// SaleItem — one line of a sale. productName is a snapshot captured at
// sale time so history remains accurate when the product master changes.
// unitPrice and totalAmount are denormalized at creation, never recomputed.
// ---------------------------------------------------------------------------
model SaleItem {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}
