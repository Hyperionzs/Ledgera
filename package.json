{
  "name": "ledgera",
  "version": "0.0.1",
  "private": true,
  "description": "Ledgera — Modern web-based Point of Sale system for small and medium businesses",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:backend": "pnpm --filter @ledgera/backend run dev",
    "dev:frontend": "pnpm --filter @ledgera/frontend run dev",
    "build": "pnpm -r run build",
    "build:backend": "pnpm --filter @ledgera/backend run build",
    "build:frontend": "pnpm --filter @ledgera/frontend run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,html,yaml,yml}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @ledgera/backend run db:generate",
    "db:migrate": "pnpm --filter @ledgera/backend run db:migrate",
    "db:seed": "pnpm --filter @ledgera/backend run db:seed",
    "db:studio": "pnpm --filter @ledgera/backend run db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
